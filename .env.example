# .env.example
#
# Copy to .env and replace every placeholder. scripts/generate-secrets.sh
# fills the three secrets automatically.
#   cp .env.example .env
#   ./scripts/generate-secrets.sh
#   chmod 600 .env

# Relay signing secret. Long random value. openssl rand -hex 64
SECRET=change_me_openssl_rand_hex_128

# PostgreSQL
DB_HOST=nostream-db
DB_PORT=5432
DB_USER=nostr_ts_relay
DB_PASSWORD=change_me_openssl_rand_hex_32
DB_NAME=nostr_ts_relay
DB_MIN_POOL_SIZE=4
DB_MAX_POOL_SIZE=16
DB_ACQUIRE_CONNECTION_TIMEOUT=60000

# Redis
REDIS_HOST=nostream-cache
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=change_me_openssl_rand_hex_32

# Relay
RELAY_PORT=8008
NOSTR_CONFIG_DIR=/home/node/.nostr
WORKER_COUNT=2

# Grafana (loopback only; reachable via `ssh -L 7777:127.0.0.1:7777`)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_openssl_rand_hex_32
GRAFANA_URL=http://127.0.0.1:7777